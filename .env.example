# ==============================================================================
# SoroTTL Dashboard Environment Configuration
# ==============================================================================

# Server-Side Only Backend Configuration (Never prefix with NEXT_PUBLIC_)
# Used exclusively by server components and internal proxy routes.
# Never expose secrets in client components, browser network logs, or client bundles.
SOROTTL_BACKEND_URL=http://127.0.0.1:8080

# Optional Bearer Token if backend authentication is enabled (SOROTTL_API_AUTH_TOKEN)
# Leave blank or omit if running local unauthenticated backend.
# SOROTTL_BACKEND_AUTH_TOKEN=your-backend-bearer-token-here

# Public Client Configuration (Safe for browser display)
NEXT_PUBLIC_APP_NAME="SoroTTL Dashboard"
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
NEXT_PUBLIC_POLL_INTERVAL_MS=10000
